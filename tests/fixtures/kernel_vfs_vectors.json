[
  {
    "case": "longest_prefix_project_source",
    "mounts": [
      {
        "name": "/project",
        "mount_type": "PROJECT",
        "real_path": "/srv/project",
        "min_ring": 1,
        "read_only": false
      },
      {
        "name": "/project/systems/python-reference-runtime",
        "mount_type": "SANDBOX",
        "real_path": "/srv/systems/python-reference-runtime",
        "min_ring": 2,
        "read_only": true
      }
    ],
    "path": "/project/systems/python-reference-runtime/main.py",
    "expect": {
      "mount": "/project/systems/python-reference-runtime",
      "rel": "main.py",
      "root": "/srv/systems/python-reference-runtime",
      "real_path": "/srv/systems/python-reference-runtime/main.py",
      "min_ring": 2,
      "read_only": true
    }
  },
  {
    "case": "project_fallback_prefix",
    "mounts": [
      {
        "name": "/project",
        "mount_type": "PROJECT",
        "real_path": "/srv/project",
        "min_ring": 1,
        "read_only": false
      },
      {
        "name": "/project/systems/python-reference-runtime",
        "mount_type": "SANDBOX",
        "real_path": "/srv/systems/python-reference-runtime",
