#!/usr/bin/env bash
# Commit-msg hook — enforce English commit messages + Co-Authored-By attribution.
#
# Rules (Praxis 宪法 §git):
#   1. Commit message MUST be written in English (reject CJK characters).
#   2. Every commit MUST carry a Co-Authored-By trailer naming the authoring
#      agent/model — attribution is a governance requirement.
#   3. Merge commits are exempt from 1-2 (git-generated messages), BUT a
#      merge that brings in a dependabot branch is gated: its diff must only
#      touch dependency files (see AGENTS.md "Dependency management").
#   Bypass (strict): PRAXIS_SKIP_AUTHOR_CHECK=1 requires explicit reason
#   and is audit-logged; prefer fixing the message over bypassing.
set -euo pipefail

msg_file="$1"
msg=$(cat "$msg_file")

if [ -n "${PRAXIS_SKIP_AUTHOR_CHECK:-}" ]; then
  if [ -z "${PRAXIS_SKIP_REASON:-}" ]; then
    echo "❌ PRAXIS_SKIP_AUTHOR_CHECK=1 requires PRAXIS_SKIP_REASON=<why>." >&2
    echo "   Fix the message instead of bypassing; bypass is audit-logged." >&2
    exit 1
  fi
  echo "⚠️  PRAXIS_SKIP_AUTHOR_CHECK bypassed (reason: $PRAXIS_SKIP_REASON) — audit logged." >&2
  # Audit the bypass for forensics.
  _audit_dir="$(git rev-parse --show-toplevel 2>/dev/null)/.praxis"
  mkdir -p "$_audit_dir" 2>/dev/null || true
  printf '{"ts":%s,"bypass":"PRAXIS_SKIP_AUTHOR_CHECK","reason":%q,"msg_head":%q}\n' \
    "$(date +%s)" "$PRAXIS_SKIP_REASON" "$(head -n1 "$msg_file" | head -c 200)" >> "$_audit_dir/commit-bypass.jsonl" 2>/dev/null || true
  exit 0
fi

# Merge commits carry git-generated messages — exempt from 1-2, but gated
# for dependabot merges (dependency-only diff scope).
first_line=$(printf '%s' "$msg" | head -n 1)
if printf '%s' "$first_line" | grep -qE '^(Merge|Revert) '; then
  # ── Dependabot merge gate ──────────────────────────────────────────
  # A merge that brings in a dependabot branch must NOT drag in
  # non-dependency files. The bot's unsigned commits also cannot land on
  # GitCode, so these merges must be validated locally first (AGENTS.md
  # "Dependency management").
  #
  # Detection does NOT rely on the message: the merged-branch tip is
  # examined directly. commit-msg runs BEFORE the commit object exists —
  # during `git merge` the incoming branch lives at MERGE_HEAD (HEAD still
  # points at the old main); after a manual `git commit` the merge is
  # already created, so fall back to HEAD^2.
  MERGE_ROOT="$(git rev-parse --git-dir)"
  if [ -f "$MERGE_ROOT/MERGE_HEAD" ]; then
    SECOND="$(cat "$MERGE_ROOT/MERGE_HEAD" 2>/dev/null || true)"
  else
    SECOND="$(git rev-parse HEAD^2 2>/dev/null || true)"
  fi
  if [ -n "$SECOND" ]; then
    # Trigger on dependabot authorship OR the message naming dependabot.
    SECOND_AUTHOR="$(git log -1 --format='%an' "$SECOND" 2>/dev/null || true)"
    IS_DEP="$([ -n "$SECOND_AUTHOR" ] && printf '%s' "$SECOND_AUTHOR" | grep -qiE 'dependabot' && echo 1 || echo 0)"
    MSG_HINT="$(printf '%s' "$msg" | grep -qiE 'dependabot|deps' && echo 1 || echo 0)"
    if [ "$IS_DEP" = "1" ] || [ "$MSG_HINT" = "1" ]; then
      MERGED_FILES="$(git diff --name-only HEAD "$SECOND" 2>/dev/null || true)"
      VIOLATIONS="$(printf '%s\n' "$MERGED_FILES" | grep -vE '^(pyproject\.toml|requirements[^/]*\.txt|uv\.lock|poetry\.lock)$' || true)"
      if [ -n "$VIOLATIONS" ]; then
        echo "❌ Dependabot merge must only touch dependency files." >&2
        echo "   Non-dependency files brought in by this merge:" >&2
        printf '%s\n' "$VIOLATIONS" | sed 's/^/     ✗ /' >&2
        echo "   Fix: split the code changes into a feature branch, or" >&2
        echo "        run bash scripts/sh/verify-deps-merge.sh <branch> first." >&2
        exit 1
      fi
      echo "--- commit-msg: dependabot merge (dependency-only diff) ---" >&2
      echo "   Reminder: run bash scripts/sh/verify-deps-merge.sh <branch>," >&2
      echo "   then push BOTH remotes via bash scripts/sh/push-both.sh main." >&2
    fi
  fi
  # If the merge message has a custom body (not just the auto-generated line),
  # it should follow Conventional Commits format for traceability.
  if printf '%s' "$msg" | grep -qE '^[A-Za-z]+\('; then
    # Custom merge message — validate subject format.
    MERGE_SUBJECT=$(printf '%s' "$msg" | head -n 1)
    if [ -f scripts/py/commit_scan.py ]; then
      python scripts/py/commit_scan.py --subject "$MERGE_SUBJECT" >/tmp/merge_scan.log 2>&1 || true
      if grep -q 'VIOLATIONS' /tmp/merge_scan.log; then
        echo "⚠️  Merge subject should follow Conventional Commits: type(scope): description" >&2
        grep '  ✗' /tmp/merge_scan.log >&2
      fi
    fi
  fi
  exit 0
fi

# 1. English-only message
if printf '%s' "$msg" | grep -qP '[\x{4e00}-\x{9fa5}]'; then
  echo "❌ Commit message must be written in English (found CJK characters)." >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi

# 1b. Format normalization (layout/typography) — commit messages are plain
#     text, never rendered markdown:
#     - no **bold** / *italic* / backtick code spans in the subject
#     - subject starts lowercase (Conventional-Commits summary style)
#     - no trailing period on the subject line
#     - Co-Authored-By is the LAST line, preceded by a blank line
first_line=$(printf '%s' "$msg" | head -n 1)
if printf '%s' "$first_line" | grep -qE '(\*\*|`|_[a-zA-Z0-9]+_)'; then
  echo "❌ Subject must be plain text — no markdown (**bold**, \`code\`, _italics_)." >&2
  echo "   Remove formatting from the subject line." >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi
if printf '%s' "$first_line" | grep -qE '^[A-Z]'; then
  echo "❌ Subject must start lowercase (Conventional-Commits style):" >&2
  echo "   'fix(l3): clear...' not 'Fix(l3): clear...'" >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi
if printf '%s' "$first_line" | grep -qE '\.$'; then
  echo "❌ Subject must not end with a period (Conventional-Commits style)." >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi

# 2. Co-Authored-By attribution — exactly one, well-formed, and TRUE.
#    The trailer must match BOTH the agents registry (commits.yaml) and the
#    live runtime detection (detect_agent.py reads env + process-chain, NOT
#    the agent's self-report). A GPT run can never claim deepseek-v4-flash,
#    and vice versa — attribution reflects who ACTUALLY executed the work.
if [ -f scripts/py/commit_scan.py ]; then
  python scripts/py/commit_scan.py --msg "$msg" >/tmp/commit_cab.log 2>&1 || true
  if grep -q 'VIOLATIONS' /tmp/commit_cab.log; then
    echo "❌ Co-Authored-By rejected (registry + runtime cross-check):" >&2
    grep '  ✗' /tmp/commit_cab.log >&2
    echo "" >&2
    echo "   HOW TO FIX (do not guess — read your actual runtime):" >&2
    echo "     1. python scripts/py/detect_agent.py --json" >&2
    echo "        → reports the framework/model that ACTUALLY runs this session" >&2
    echo "     2. use THAT model name in the trailer; agent name must be" >&2
    echo "        registered in config/discovery/commits.yaml (agents:)" >&2
    echo "     3. correct form:" >&2
    echo "        Co-Authored-By: <registered-agent> (<detected-model>) <noreply@domain>" >&2
    DETECTED="$(python scripts/py/detect_agent.py --json 2>/dev/null || echo '')"
    echo "     4. (this session detects:) ${DETECTED:-<detection unavailable>}" >&2
    echo "   Only if you are deliberately overriding attribution (manual/" >&2
    echo "   historical commits): PRAXIS_SKIP_AUTHOR_CHECK=1." >&2
    exit 1
  fi
else
  # No commit_scan.py (scratch repo) — legacy inline format guard.
  CAB_COUNT=$(printf '%s' "$msg" | grep -c "Co-Authored-By:")
  if [ "$CAB_COUNT" -lt 1 ]; then
    echo "❌ Commit must include a Co-Authored-By trailer for attribution." >&2
    exit 1
  fi
  if [ "$CAB_COUNT" -gt 1 ]; then
    echo "❌ Exactly ONE Co-Authored-By trailer is allowed (found $CAB_COUNT)." >&2
    exit 1
  fi
  if ! printf '%s' "$msg" | grep -qE '^Co-Authored-By: [^:<>]+ \([^()]+\) <noreply@[a-z0-9.-]+>$'; then
    echo "❌ Co-Authored-By must match: \`Co-Authored-By: <Agent> (<model>) <noreply@domain>\`" >&2
    exit 1
  fi
fi

# 3. Conventional-commits type(scope): summary — also the CHANGELOG
#    signal: generate-changelog.py only records subjects that match here, so a
#    non-conventional subject would be silently dropped from the changelog.
#    Full policy scan delegates to scripts/py/commit_scan.py (single source
#    of truth: config/discovery/commits.yaml — type whitelist, registered
#    scopes, placeholder guard, branch-type policy). Exit codes:
#      0 = OK; 1 = violation; 2 = runtime unavailable (fall back to the
#      legacy regex so a missing python/yaml never blocks commits).
first_line=$(printf '%s' "$msg" | head -n 1)
SCAN_RC=0
if [ -f scripts/py/commit_scan.py ]; then
  python scripts/py/commit_scan.py --subject "$first_line" \
    --branch "$(git branch --show-current 2>/dev/null || true)" \
    >/tmp/commit_scan.log 2>&1 || SCAN_RC=$?
fi
if [ "$SCAN_RC" = "1" ]; then
  echo "❌ commit-scan rejected the subject:" >&2
  tail -5 /tmp/commit_scan.log >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi
if [ "$SCAN_RC" != "0" ]; then
  # runtime unavailable (2) or script absent — legacy inline regex fallback.
  if ! printf '%s' "$first_line" | grep -qE '^(feat|fix|perf|docs|refactor|style|test|chore|build|ci|revert)(\([a-z0-9_.-]+\))?!?: '; then
    echo "❌ Subject must be Conventional Commits: \`type(scope): summary\`" >&2
    echo "   type ∈ feat|fix|perf|docs|refactor|style|test|chore|build|ci|revert" >&2
    echo "   Example: feat(core): add token ring revocation" >&2
    echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
    exit 1
  fi
fi

# ── 3b. Validator (type/scope registration + must_include) ───────────────
# Primary: validate-commit.mjs (node). Fallback when node is absent (WSL
# side): scripts/py/commit_scan.py enforces the SAME commits.yaml contract
# (scope registration + type-to-content consistency) so the gate never
# silently degrades to pass-through.
if command -v node >/dev/null 2>&1; then
  node scripts/js/validate-commit.mjs "$msg_file" >&2 || exit 1
else
  PY="$(command -v python3 || command -v python || true)"
  if [ -n "$PY" ] && "$PY" -c "import yaml" >/dev/null 2>&1; then
    BR="$(git symbolic-ref --short HEAD 2>/dev/null || echo main)"
    "$PY" scripts/py/commit_scan.py --branch "$BR" --msg "$(cat "$msg_file")" --check-content >&2 || exit 1
  else
    echo "⚠️  node and python+yaml both unavailable — type/scope/must_include validation SKIPPED" >&2
  fi
fi

# ── 4. Shared-file handoff gate (STRICT — register or reject) ─────────────
# A commit touching shared files (scripts/sh, .githooks, config/discovery)
# MUST also update docs/agent-handoff/ALIGNMENT.md (Shared-file change log)
# so parallel agents can reconcile — otherwise the change is rejected.
SHARED_HIT="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '^(scripts/sh/|\.githooks/|config/discovery/)' | head -1 || true)"
if [ -n "$SHARED_HIT" ]; then
  ALIGN_REGISTERED="$(git diff --cached --name-only 2>/dev/null | grep -c '^docs/agent-handoff/ALIGNMENT.md' || true)"
  if [ "$ALIGN_REGISTERED" = "0" ]; then
    echo "❌ Shared-file change ($SHARED_HIT) requires a registration line in docs/agent-handoff/ALIGNMENT.md (Shared-file change log)." >&2
    echo "   Add a row (date | file | agent | change | status) to ALIGNMENT.md in THIS commit, then retry." >&2
    exit 1
  fi
  echo "ℹ️  Shared-file change: $SHARED_HIT — ALIGNMENT.md registration present." >&2
fi

exit 0
