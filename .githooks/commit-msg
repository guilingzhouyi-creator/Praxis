#!/usr/bin/env bash
# Commit-msg hook — enforce English commit messages + Co-Authored-By attribution.
#
# Rules (Praxis 宪法 §git):
#   1. Commit message MUST be written in English (reject CJK characters).
#   2. Every commit MUST carry a Co-Authored-By trailer naming the authoring
#      agent/model — attribution is a governance requirement.
#   3. Merge commits are exempt from 1-2 (git-generated messages), BUT a
#      merge that brings in a dependabot branch is gated: its diff must only
#      touch dependency files (see AGENTS.md "Dependency management").
#   Bypass (temporary): PRAXIS_SKIP_AUTHOR_CHECK=1
set -euo pipefail

# Resolve a Node.js interpreter. Prefer an explicit override, then PATH.
NODE_CMD="${PRAXIS_NODE:-}"
if [ -z "$NODE_CMD" ]; then
  NODE_CMD="$(command -v node 2>/dev/null || true)"
fi
if [ -z "$NODE_CMD" ]; then
  echo "commit-msg: no node interpreter found; commit validation skipped" >&2
fi

msg_file="$1"
msg=$(cat "$msg_file")

# Bypass is narrowed: only author attribution is skipped, and only with an
# explicit reason. Format/template checks below ALWAYS run (not bypassable).
SKIP_AUTHOR=""
if [ -n "${PRAXIS_SKIP_AUTHOR_CHECK:-}" ]; then
  if [ -z "${PRAXIS_GATE_BYPASS_REASON:-}" ]; then
    echo "❌ PRAXIS_SKIP_AUTHOR_CHECK requires PRAXIS_GATE_BYPASS_REASON (why the author check is skipped)." >&2
    exit 1
  fi
  SKIP_AUTHOR=1
  echo "⚠️  author check bypassed (reason: ${PRAXIS_GATE_BYPASS_REASON}) — format checks still run" >&2
fi

# Merge commits carry git-generated messages — exempt from 1-2, but gated
# for dependabot merges (dependency-only diff scope).
first_line=$(printf '%s' "$msg" | head -n 1)
if printf '%s' "$first_line" | grep -qE '^(Merge|Revert) '; then
  # ── Dependabot merge gate ──────────────────────────────────────────
  # A merge that brings in a dependabot branch must NOT drag in
  # non-dependency files. The bot's unsigned commits also cannot land on
  # GitCode, so these merges must be validated locally first (AGENTS.md
  # "Dependency management").
  #
  # Detection does NOT rely on the message: the merged-branch tip is
  # examined directly. commit-msg runs BEFORE the commit object exists —
  # during `git merge` the incoming branch lives at MERGE_HEAD (HEAD still
  # points at the old main); after a manual `git commit` the merge is
  # already created, so fall back to HEAD^2.
  # Worktrees under some hosts fail to resolve the git dir (exit 128); an
  # empty MERGE_ROOT simply skips the dependabot gate instead of aborting.
  MERGE_ROOT="$(git rev-parse --git-dir 2>/dev/null || true)"
  if [ -z "$MERGE_ROOT" ]; then
    echo "commit-msg: dependabot merge gate skipped — cannot resolve git dir" >&2
  fi
  if [ -f "$MERGE_ROOT/MERGE_HEAD" ]; then
    SECOND="$(cat "$MERGE_ROOT/MERGE_HEAD" 2>/dev/null || true)"
  else
    SECOND="$(git rev-parse HEAD^2 2>/dev/null || true)"
  fi
  if [ -n "$SECOND" ]; then
    # Trigger on dependabot authorship OR the message naming dependabot.
    SECOND_AUTHOR="$(git log -1 --format='%an' "$SECOND" 2>/dev/null || true)"
    IS_DEP="$([ -n "$SECOND_AUTHOR" ] && printf '%s' "$SECOND_AUTHOR" | grep -qiE 'dependabot' && echo 1 || echo 0)"
    MSG_HINT="$(printf '%s' "$msg" | grep -qiE 'dependabot|deps' && echo 1 || echo 0)"
    if [ "$IS_DEP" = "1" ] || [ "$MSG_HINT" = "1" ]; then
      MERGED_FILES="$(git diff --name-only HEAD "$SECOND" 2>/dev/null || true)"
      VIOLATIONS="$(printf '%s\n' "$MERGED_FILES" | grep -vE '^(pyproject\.toml|requirements[^/]*\.txt|uv\.lock|poetry\.lock)$' || true)"
      if [ -n "$VIOLATIONS" ]; then
        echo "❌ Dependabot merge must only touch dependency files." >&2
        echo "   Non-dependency files brought in by this merge:" >&2
        printf '%s\n' "$VIOLATIONS" | sed 's/^/     ✗ /' >&2
        echo "   Fix: split the code changes into a feature branch, or" >&2
        echo "        run bash scripts/sh/verify-deps-merge.sh <branch> first." >&2
        exit 1
      fi
      echo "--- commit-msg: dependabot merge (dependency-only diff) ---" >&2
      echo "   Reminder: run bash scripts/sh/verify-deps-merge.sh <branch>," >&2
      echo "   then push BOTH remotes via bash scripts/sh/push-both.sh main." >&2
    fi
  fi
  # If the merge message has a custom body (not just the auto-generated line),
  # it should follow Conventional Commits format for traceability.
  if printf '%s' "$msg" | grep -qE '^[A-Za-z]+\('; then
    # Custom merge message — validate subject format.
    MERGE_SUBJECT=$(printf '%s' "$msg" | head -n 1)
    # Custom merge message — validate subject format via Node.js.
    if [ -f scripts/js/validate-commit.mjs ]; then
      if [ -n "$NODE_CMD" ]; then
        "$NODE_CMD" scripts/js/validate-commit.mjs /dev/stdin <<< "$MERGE_SUBJECT" 2>/tmp/merge_scan.log || true
      fi
      if [ -s /tmp/merge_scan.log ]; then
        echo "⚠️  Merge subject should follow Conventional Commits: type(scope): description" >&2
        cat /tmp/merge_scan.log >&2
      fi
    fi
  fi
  exit 0
fi

# 1. English-only message
if printf '%s' "$msg" | grep -qP '[\x{4e00}-\x{9fa5}]'; then
  echo "❌ Commit message must be written in English (found CJK characters)." >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi

# 1b. Format normalization (layout/typography) — commit messages are plain
#     text, never rendered markdown:
#     - no **bold** / *italic* / backtick code spans in the subject
#     - subject starts lowercase (Conventional-Commits summary style)
#     - no trailing period on the subject line
#     - Co-Authored-By is the LAST line, preceded by a blank line
first_line=$(printf '%s' "$msg" | head -n 1)
if printf '%s' "$first_line" | grep -qE '(\*\*|`|_[a-zA-Z0-9]+_)'; then
  echo "❌ Subject must be plain text — no markdown (**bold**, \`code\`, _italics_)." >&2
  echo "   Remove formatting from the subject line." >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi
if printf '%s' "$first_line" | grep -qE '^[A-Z]'; then
  echo "❌ Subject must start lowercase (Conventional-Commits style):" >&2
  echo "   'fix(l3): clear...' not 'Fix(l3): clear...'" >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi
if printf '%s' "$first_line" | grep -qE '\.$'; then
  echo "❌ Subject must not end with a period (Conventional-Commits style)." >&2
  echo "   Fix the message, or set PRAXIS_SKIP_AUTHOR_CHECK=1 to bypass." >&2
  exit 1
fi

# 1c. Body template (governance — not bypassable): a non-empty body must
#     follow the AGENTS.md template — a "## " section heading, a
#     "**keyword**" emphasis and "- " bullets. Mirrors the push-both
#     audit so the template is enforced at commit time.
body=$(printf '%s' "$msg" | tail -n +2 | grep -v '^Co-Authored-By:' | sed '/^[[:space:]]*$/d')
if [ -n "$body" ]; then
  missing=""
  printf '%s' "$body" | grep -qE '^##[[:space:]]' || missing="$missing '## ' section heading"
  printf '%s' "$body" | grep -qE '\*\*[^*]+\*\*' || missing="$missing '**keyword**' emphasis"
  printf '%s' "$body" | grep -qE '(^|[[:space:]])- ' || missing="$missing '- ' bullets"
  if [ -n "$missing" ]; then
    echo "❌ Commit body lacks:$missing (AGENTS.md template — write the message per the template)." >&2
    echo "   Use: body = '## What' + '## Why' sections, **keyword** emphasis, '- ' bullets." >&2
    echo "   Full field spec: docs/workflow/commits.md 'Message contract'." >&2
    exit 1
  fi
fi

# 2. Full validation via Node.js — type, scope, Co-Authored-By, attribution.
#    Replaces the Python-based commit_scan.py + detect_agent.py calls.
#    Config-driven: reads config/discovery/commits.json for type/scope/agent
#    whitelists so no Python runtime is needed.
if [ -z "${SKIP_AUTHOR:-}" ] && [ -f scripts/js/validate-commit.mjs ]; then
  if [ -n "$NODE_CMD" ]; then
    "$NODE_CMD" scripts/js/validate-commit.mjs "$msg_file" 2>/tmp/validate.log || true
  fi
  if [ -s /tmp/validate.log ]; then
    echo "❌ Commit validation failed:" >&2
    cat /tmp/validate.log >&2
    exit 1
  fi
else
  # No validate-commit.mjs (scratch repo) — legacy inline format guard.
  CAB_COUNT=$(printf '%s' "$msg" | grep -c "Co-Authored-By:")
  if [ "$CAB_COUNT" -lt 1 ]; then
    echo "❌ Commit must include a Co-Authored-By trailer for attribution." >&2
    exit 1
  fi
  if [ "$CAB_COUNT" -gt 1 ]; then
    echo "❌ Exactly ONE Co-Authored-By trailer is allowed (found $CAB_COUNT)." >&2
    exit 1
  fi
  if ! printf '%s' "$msg" | grep -qE '^Co-Authored-By: [^:<>]+ \([^()]+\) <[^@>]+@[^>]+>$'; then
    echo "❌ Co-Authored-By must match: \`Co-Authored-By: <Agent> (<model>) <email>\`" >&2
    exit 1
  fi
  # Legacy CC format check (no config file available).
  if ! printf '%s' "$first_line" | grep -qE '^(feat|fix|perf|docs|refactor|style|test|chore|build|ci|revert)(\([a-z0-9_.-]+\))?!?: '; then
    echo "❌ Subject must be Conventional Commits: \`type(scope): summary\`" >&2
    exit 1
  fi
fi

# 3. Execution-environment attribution check — the declared Co-Authored-By
#    model must match the CURRENT runtime. Agents must self-check their
#    environment and model before committing — do NOT copy a previous
#    commit's trailer (the declared model would mismatch this session).
DECLARED_MODEL="$(printf '%s' "$msg" | grep -oE 'Co-Authored-By: .+\(([^)]+)\)' | sed -E 's/.*\(([^)]+)\)$/\1/' | tail -1 || true)"
if [ -n "$DECLARED_MODEL" ]; then
  # Primary: the model env var for THIS session (set by the harness/agent).
  ENV_MODEL="${PRAXIS_MODEL:-}"
  if [ -n "$ENV_MODEL" ] && [ "$DECLARED_MODEL" != "$ENV_MODEL" ]; then
    echo "❌ Co-Authored-By model \"$DECLARED_MODEL\" does not match the executing environment (PRAXIS_MODEL=\"$ENV_MODEL\")." >&2
    echo "   Before committing, self-check your runtime and model — do NOT copy a previous commit's trailer." >&2
    exit 1
  fi
  # Secondary: execution evidence (detect_agent.py) when it can identify the model.
  PY_CMD="${PRAXIS_PYTHON:-}"
  if [ -z "$PY_CMD" ]; then
    if [ -x .venv/bin/python ]; then PY_CMD=.venv/bin/python
    elif command -v python3 >/dev/null 2>&1; then PY_CMD=python3
    else PY_CMD=python; fi
  fi
  if [ -n "$PY_CMD" ] && [ -f scripts/py/detect_agent.py ]; then
    DETECTED_MODEL="$("$PY_CMD" scripts/py/detect_agent.py --json 2>/dev/null | "$PY_CMD" -c 'import sys,json; print(json.load(sys.stdin).get("model",""))' 2>/dev/null || true)"
    if [ -n "$DETECTED_MODEL" ] && [ "$DECLARED_MODEL" != "$DETECTED_MODEL" ]; then
      echo "❌ Co-Authored-By model \"$DECLARED_MODEL\" does not match execution evidence (detected \"$DETECTED_MODEL\")." >&2
      echo "   Self-check your runtime and model before committing — attribute what actually ran." >&2
      exit 1
    fi
  fi
fi

exit 0
