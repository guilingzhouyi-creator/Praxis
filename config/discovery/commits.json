  "placeholder": {
    "reject_empty_summary": true,
    "reject_cjk_summary": true,
    "min_summary_chars": 10
  },
  "max_subject_chars": 72,
  "body": {
    "require_sections": true,
    "require_bullets": true,
    "require_keywords": true
  },
  "strictness": "strict",
  "branch_policy": {
    "patterns": [
      {
        "pattern": "fix*",
        "allowed_types": [
          "fix"
        ]
      },
      {
        "pattern": "feature/*",
        "allowed_types": [
          "feat",
          "fix",
          "perf",
          "docs",
          "refactor",
          "style",
          "test",
          "chore",
          "build",
          "ci"
        ]
      }
    ]
  }
}